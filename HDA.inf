[HDA_ULi.Wave.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%ULi.Wave.szPname%

[HDA_ULi.Topo]
AddReg=HDA_ULi.Topo.AddReg
[HDA_ULi.Topo.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%ULi.Topology.szPname%

[HDA_ULi.AddReg]
HKR,Drivers\wave\wdmaud.drv,Description,,%ULi.DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%ULi.DeviceDesc%

[HDA_ULi.NT]
Include=ks.inf, wdmaudio.inf
Needs=KS.Registration, WDMAUDIO.Registration
CopyFiles=HDA.CopyList
AddReg=WDM_HDA.AddReg, HDA_ULi.AddReg

[HDA_ULi.NT.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_Wave%,HDA_ULi.Wave
AddInterface=%KSCATEGORY_RENDER%,%KSNAME_Wave%,HDA_ULi.Wave
AddInterface=%KSCATEGORY_CAPTURE%,%KSNAME_Wave%,HDA_ULi.Wave
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_Topology%,HDA_ULi.Topo
AddInterface=%KSCATEGORY_TOPOLOGY%,%KSNAME_Topology%,HDA_ULi.Topo

[HDA_ULi.NT.Services]
AddService = HDA, 0x00000002, sndblst_Service_Inst

;;============================================================================
;; Driver Installation Sections - Generic / Fallback
;;============================================================================
[HDA_Generic]
AlsoInstall=KS.Registration(ks.inf),WDMAUDIO.Registration(wdmaudio.inf)
CopyFiles=HDA.CopyList
AddReg=WDM_HDA.AddReg, HDA_Generic.AddReg

[HDA_Generic.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_Wave%,HDA_Generic.Wave
AddInterface=%KSCATEGORY_RENDER%,%KSNAME_Wave%,HDA_Generic.Wave
AddInterface=%KSCATEGORY_CAPTURE%,%KSNAME_Wave%,HDA_Generic.Wave
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_Topology%,HDA_Generic.Topo
AddInterface=%KSCATEGORY_TOPOLOGY%,%KSNAME_Topology%,HDA_Generic.Topo

[HDA_Generic.Wave]
AddReg=HDA_Generic.Wave.AddReg
[HDA_Generic.Wave.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Generic.Wave.szPname%

[HDA_Generic.Topo]
AddReg=HDA_Generic.Topo.AddReg
[HDA_Generic.Topo.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Generic.Topology.szPname%

[HDA_Generic.AddReg]
HKR,Drivers\wave\wdmaud.drv,Description,,%Generic.DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%Generic.DeviceDesc%

[HDA_Generic.NT]
Include=ks.inf, wdmaudio.inf
Needs=KS.Registration, WDMAUDIO.Registration
CopyFiles=HDA.CopyList
AddReg=WDM_HDA.AddReg, HDA_Generic.AddReg

[HDA_Generic.NT.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_Wave%,HDA_Generic.Wave
AddInterface=%KSCATEGORY_RENDER%,%KSNAME_Wave%,HDA_Generic.Wave
AddInterface=%KSCATEGORY_CAPTURE%,%KSNAME_Wave%,HDA_Generic.Wave
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_Topology%,HDA_Generic.Topo
AddInterface=%KSCATEGORY_TOPOLOGY%,%KSNAME_Topology%,HDA_Generic.Topo

[HDA_Generic.NT.Services]
AddService = HDA, 0x00000002, sndblst_Service_Inst

;;============================================================================
;; Common Registry Entries
;;============================================================================
[WDM_HDA.AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,HDA.SYS
HKR,,NTMPDriver,,"HDA.sys,sbemul.sys"

HKR,Drivers,SubClasses,,"wave,midi,mixer"

HKR,Drivers\wave\wdmaud.drv, Driver,,wdmaud.drv
HKR,Drivers\midi\wdmaud.drv, Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv

HKR,Drivers\midi\wdmaud.drv,Description,,%WDM_MIDI%

;; Configuration Options
;; Edit the last number to 0 or 1 to switch options on and off

HKR,Settings,SkipControllerReset,0x00010001,0
HKR,Settings,SkipCodecReset,0x00010001,0
HKR,Settings,UseAltOut,0x00010001,0
HKR,Settings,UseSPDIF,0x00010001,1
HKR,Settings,UseDisabledPins,0x00010001,0
HKR,Settings,UseDmaPos,0x00010001,0

; Allow 96 khz audio. Works on 98 but lowers performance
HKR,Settings,AllowHighRate,0x00010001,0
; Allow 32-bit bit-depth. Does NOT work on 98!! needs >= 2k SP3
; And it still won't work if your audio codec does not support it
HKR,Settings,AllowHighDepth,0x00010001,0
; Allow blind probe of all 16 codec slots if STATESTS is 0 (off by default to prevent hangs)
HKR,Settings,AllowBlindProbe,0x00010001,0

[DestinationDirs]
HDA.CopyList      = 10,system32\drivers ; %SystemRoot%\system32\drivers

[HDA.CopyList]
HDA.sys

;;============================================================================
;; NT Service Installation
;;============================================================================
[sndblst_Service_Inst]
DisplayName    = %sndblst.SvcDesc%
ServiceType    = 1                  ; SERVICE_KERNEL_DRIVER
StartType      = 3                  ; SERVICE_DEMAND_START
ErrorControl   = 1                  ; SERVICE_ERROR_NORMAL
ServiceBinary  = %10%\system32\drivers\HDA.sys

