;Drew Does what Intel isn't
;
; Module Name:
;    HDA.INF
;
; Abstract:
;    INF file for installing HDA Controller Driver

[Version]
Signature="$CHICAGO$"
Class=MEDIA
ClassGUID={4d36e96c-e325-11ce-bfc1-08002be10318}
provider=%MFG%
DriverVer=11/11/2026,5.00.2195.26

[SourceDisksNames]
222=%DiskDescription%,,,

[SourceDisksFiles]
HDA.sys=222

[Manufacturer]
%MfgCreative%=Creative
%MfgIntel%=Intel
%MfgAMD%=AMD
%MfgNVIDIA%=NVIDIA
%MfgVIA%=VIA
%MfgVMware%=VMware
%MfgULi%=ULi
%MfgGeneric%=Generic

[ControlFlags]
ExcludeFromSelect = *EXCLUDE

[STUB_DEVICE]

[STUB_DEVICE.NT]
[STUB_DEVICE.NT.SERVICES]
AddService=,0x2

