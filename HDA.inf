;;============================================================================
;; Driver Installation Sections - Creative
;;============================================================================
[HDA_Creative]
AlsoInstall=KS.Registration(ks.inf),WDMAUDIO.Registration(wdmaudio.inf)
CopyFiles=HDA.CopyList
AddReg=WDM_HDA.AddReg, HDA_Creative.AddReg

[HDA_Creative.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_Wave%,HDA_Creative.Wave
AddInterface=%KSCATEGORY_RENDER%,%KSNAME_Wave%,HDA_Creative.Wave
AddInterface=%KSCATEGORY_CAPTURE%,%KSNAME_Wave%,HDA_Creative.Wave
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_Topology%,HDA_Creative.Topo
AddInterface=%KSCATEGORY_TOPOLOGY%,%KSNAME_Topology%,HDA_Creative.Topo

[HDA_Creative.Wave]
AddReg=HDA_Creative.Wave.AddReg
[HDA_Creative.Wave.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Creative.Wave.szPname%

[HDA_Creative.Topo]
AddReg=HDA_Creative.Topo.AddReg
[HDA_Creative.Topo.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Creative.Topology.szPname%

[HDA_Creative.AddReg]
HKR,Drivers\wave\wdmaud.drv,Description,,%Creative.DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%Creative.DeviceDesc%

[HDA_Creative.NT]
Include=ks.inf, wdmaudio.inf
Needs=KS.Registration, WDMAUDIO.Registration
CopyFiles=HDA.CopyList
AddReg=WDM_HDA.AddReg, HDA_Creative.AddReg

[HDA_Creative.NT.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_Wave%,HDA_Creative.Wave
AddInterface=%KSCATEGORY_RENDER%,%KSNAME_Wave%,HDA_Creative.Wave
AddInterface=%KSCATEGORY_CAPTURE%,%KSNAME_Wave%,HDA_Creative.Wave
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_Topology%,HDA_Creative.Topo
AddInterface=%KSCATEGORY_TOPOLOGY%,%KSNAME_Topology%,HDA_Creative.Topo

[HDA_Creative.NT.Services]
AddService = HDA, 0x00000002, sndblst_Service_Inst

